        {
          "ingredientId": "sal",
          "optional": false
        }
      ],
      "steps": [
        {
          "text": "Sofríe la cebolla en la mantequilla hasta que esté transparente.",
          "minutes": 3
        },
        {
          "text": "Agrega el tomate y cocina hasta que suelte el jugo.",
          "minutes": 3
        },
        {
          "text": "Bate los huevos con sal, viértelos y revuelve suave hasta que cuajen."
        },
        {
          "text": "Asa las arepas y sirve al lado."
        }
