    {
      "id": "pancakes-arandanos",
      "name": "Pancakes de arándanos",
      "description": "Esponjosos, con arándanos que revientan en la sartén.",
      "meals": [
        "desayuno",
        "once"
      ],
      "prepMinutes": 10,
      "cookMinutes": 15,
      "servings": 4,
      "difficulty": 1,
      "ingredients": [
        {
          "ingredientId": "harina",
          "optional": false,
          "qty": 1.5,
          "unit": "taza"
        },
        {
          "ingredientId": "leche",
          "optional": false,
          "qty": 1.25,
          "unit": "taza"
        },
        {
          "ingredientId": "huevo",
          "optional": false,
          "qty": 1
        },
        {
          "ingredientId": "azucar",
          "optional": false,
          "qty": 2,
          "unit": "cda"
        },
        {
          "ingredientId": "polvo-hornear",
          "optional": false,
          "qty": 2,
          "unit": "cdta"
        },
        {
          "ingredientId": "mantequilla",
          "optional": false,
          "qty": 2,
          "unit": "cda",
          "note": "derretida"
        },
        {
          "ingredientId": "arandanos",
          "optional": false,
          "qty": 1,
          "unit": "taza"
        },
        {
          "ingredientId": "sal",
          "optional": false,
          "note": "una pizca"
        },
        {
          "ingredientId": "miel",
          "optional": true
        }
      ],
      "steps": [
        {
          "text": "Mezcla en un tazón la harina, el azúcar, el polvo de hornear y la sal."
        },
        {
          "text": "En otro tazón bate la leche, el huevo y la mantequilla derretida."
        },
        {
          "text": "Une los líquidos con los secos sin batir de más: está bien si quedan grumos."
        },
        {
          "text": "Calienta una sartén a fuego medio con un poco de mantequilla. Vierte ¼ de taza de mezcla y reparte arándanos encima.",
          "minutes": 2
        },
        {
          "text": "Voltea cuando salgan burbujas en la superficie y dora el otro lado.",
          "minutes": 1
        },
        {
          "text": "Sirve con miel o más arándanos."
        }
      ],
      "tags": [
        "dulce"
      ]
    },
    {
      "id": "huevos-pericos",
      "name": "Huevos pericos con arepa",
      "description": "El desayuno de siempre: huevo revuelto con tomate y cebolla.",
      "meals": [
        "desayuno",
        "cena"
      ],
      "prepMinutes": 5,
      "cookMinutes": 10,
      "servings": 2,
